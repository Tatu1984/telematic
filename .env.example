# Database - PostgreSQL for production
# Get a free PostgreSQL database from:
# - Vercel Postgres: https://vercel.com/storage/postgres
# - Neon: https://neon.tech
# - Supabase: https://supabase.com
# - Railway: https://railway.app

DATABASE_URL="postgresql://user:password@host:5432/fleettrack?sslmode=require"

# Auth Secret - Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-generate-with-openssl"

# NextAuth URL - Your production domain
AUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Sentry Error Tracking (optional)
# Create account at: https://sentry.io
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-org"
SENTRY_PROJECT="fleettrack-pro"

# Rate Limiting Configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# Seed Secret (optional - for automated database seeding)
# Generate with: openssl rand -hex 32
SEED_SECRET=""
