# =============================================================================
# FleetTrack Pro - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# PostgreSQL database URL for production
# Get a free PostgreSQL database from:
# - Vercel Postgres: https://vercel.com/storage/postgres
# - Neon: https://neon.tech (recommended for serverless)
# - Supabase: https://supabase.com
# - Railway: https://railway.app

DATABASE_URL="postgresql://user:password@host:5432/fleettrack?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION (Required)
# -----------------------------------------------------------------------------
# Auth Secret - Generate with: openssl rand -base64 32
# IMPORTANT: Use a unique, random value in production!
AUTH_SECRET="your-super-secret-key-generate-with-openssl"

# NextAuth URL - Your production domain
AUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL="https://your-domain.vercel.app"

# -----------------------------------------------------------------------------
# RATE LIMITING (Required for Production)
# -----------------------------------------------------------------------------
# Default rate limits (requests per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Upstash Redis (Required for production - serverless rate limiting)
# Get free account at: https://upstash.com
# In-memory rate limiting is used as fallback for development
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# -----------------------------------------------------------------------------
# ERROR TRACKING (Recommended for Production)
# -----------------------------------------------------------------------------
# Sentry Error Tracking
# Create account at: https://sentry.io
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-org"
SENTRY_PROJECT="fleettrack-pro"

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# SEED & DEMO (Development Only)
# -----------------------------------------------------------------------------
# Seed Secret (optional - for automated database seeding)
# Generate with: openssl rand -hex 32
SEED_SECRET=""

# Demo Password (optional - for demo credentials in seeded data)
# Must meet password requirements: 12+ chars, upper, lower, number, special char
# Default: FleetTrack2024!
DEMO_PASSWORD="FleetTrack2024!"

# -----------------------------------------------------------------------------
# E2E TESTING (Optional)
# -----------------------------------------------------------------------------
# Base URL for Playwright tests
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure you have:
#
# 1. [ ] Set a unique, strong AUTH_SECRET
# 2. [ ] Configured PostgreSQL database with SSL
# 3. [ ] Set up Upstash Redis for rate limiting
# 4. [ ] Configured Sentry for error tracking
# 5. [ ] Set correct AUTH_URL/NEXTAUTH_URL for your domain
# 6. [ ] Removed or secured demo credentials
# 7. [ ] Run `npm run db:migrate:prod` to apply migrations
# 8. [ ] Run `npm run build` to verify no build errors
# 9. [ ] Set up proper backup strategy for database
# 10.[ ] Configure proper logging and monitoring
# =============================================================================
